{
  "name": "linkedin-intent-classifier",
  "version": "1.0.0",
  "description": "LLM-based intent classification for LinkedIn replies",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "npx drizzle-kit push:pg && node dist/index.js",
    "test": "jest",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit push:pg",
    "db:migrate-data": "ts-node src/db/migrate-from-json.ts",
    "db:studio": "drizzle-kit studio",
    "db:test": "ts-node -e \"import('./src/db/connection').then(m => m.testConnection())\""
  },
  "keywords": [
    "linkedin",
    "intent-classification",
    "llm",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "@anthropic-ai/sdk": "^0.20.0",
    "openai": "^4.28.0",
    "dotenv": "^16.4.1",
    "zod": "^3.22.4",
    "uuid": "^9.0.1",
    "drizzle-orm": "^0.29.0",
    "pg": "^8.11.3",
    "typescript": "^5.3.3",
    "drizzle-kit": "^0.20.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.17",
    "@types/uuid": "^9.0.7",
    "@types/pg": "^8.10.0",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12"
  }
}