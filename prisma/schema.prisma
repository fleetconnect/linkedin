// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadState {
  NEW
  NORMALIZED
  DISQUALIFIED
  QUALIFIED
  CONTACTED
  REPLIED
  BOOKED
  CLOSED
}

model Campaign {
  campaign_id String @id @default(uuid())
  client_id   String

  name   String?
  status String? // active | paused | archived

  // JSON fields for flexible configuration
  icp_config      Json? // titles, industries, size
  scoring_rules   Json? // thresholds, disqualifiers
  messaging_rules Json? // tone, CTA constraints

  license_tier String? // operator | partner | enterprise

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relationships
  leads Lead[]

  @@map("campaigns")
}

model Lead {
  lead_id     String    @id @default(uuid())
  campaign_id String
  state       LeadState @default(NEW)

  // Data fields - every tool mutation updates this object
  raw_input   Json? // Original raw input data
  normalized  Json? // Normalized/processed data
  score       Json? // Scoring information
  messages    Json? // Array of message objects
  last_intent String? // Last detected intent

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relationships
  campaign Campaign @relation(fields: [campaign_id], references: [campaign_id], onDelete: Cascade)

  @@index([campaign_id])
  @@index([state])
  @@map("leads")
}
