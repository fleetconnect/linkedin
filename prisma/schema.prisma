// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campaign {
  campaign_id String @id @default(uuid())
  client_id   String

  name   String?
  status String? // active | paused | archived

  // JSON fields for flexible configuration
  icp_config      Json? // titles, industries, size
  scoring_rules   Json? // thresholds, disqualifiers
  messaging_rules Json? // tone, CTA constraints

  license_tier String? // operator | partner | enterprise

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("campaigns")
}
