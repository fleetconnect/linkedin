# Claude API Configuration (REQUIRED for classification & messaging)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude Model Configuration
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_TEMPERATURE=0.7
CLAUDE_MAX_TOKENS=4096

# Claude Classification Settings
CLAUDE_CLASSIFICATION_MODEL=claude-3-5-sonnet-20241022
CLAUDE_CLASSIFICATION_TEMPERATURE=0.3
CLAUDE_CLASSIFICATION_MAX_TOKENS=500

# Perplexity API Configuration (for company research)
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Slack Notifications (for validation failure alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Classification Configuration
CONFIDENCE_THRESHOLD=0.7

# Research Configuration
RESEARCH_MODEL=sonar-pro
RESEARCH_TIMEOUT=30000

# Storage Configuration
# Options: 'file' (default, JSON-based) or 'postgres' (PostgreSQL)
STORAGE_TYPE=file

# PostgreSQL Database Configuration (only needed if STORAGE_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=linkedin_outreach
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Database Connection Pool
DB_POOL_MAX=20

# Server Configuration
PORT=3000
NODE_ENV=development
